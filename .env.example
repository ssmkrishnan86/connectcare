# ====================================================================
# ConnectedCare - Environment Variables Template
# Copy this file to .env or configure your system environment variables
# ====================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ConnectCare
DB_USER=postgres
DB_PASSWORD=root
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=ConnectCare;Username=postgres;Password=root;"

# JWT Security
Jwt__Issuer=ConnectedCare
Jwt__Audience=ConnectedCare.Web
Jwt__SecretKey=SuperSecretKeyForConnectedCareAdminPortalHospitalSystem2026

# Backend Web API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5231

# Frontend Configuration
VITE_API_URL=http://localhost:5231
